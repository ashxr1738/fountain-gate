{
  "expo": {
    "name": "Fountain Gate Equipment",
    "slug": "fountain-gate-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fountaingate",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1e293b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.fountaingate.equipment",
      "infoPlist": {
        "NSCameraUsageDescription": "Fountain Gate equipment scanner needs camera access to scan asset QR codes and barcodes for checkouts and returns."
      }
    },
    "android": {
      "package": "org.fountaingate.equipment",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Fountain Gate Equipment to access camera for scanning QR codes and barcodes."
        }
      ],
      "expo-asset"
    ]
  }
}
