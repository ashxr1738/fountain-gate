{
  "name": "church-equipment-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "mobile"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:all": "npm run dev --workspace=backend & npm run dev --workspace=frontend & npm run dev --workspace=mobile",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:mobile": "npm run dev --workspace=mobile",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace=backend",
    "start:mobile": "npm run start --workspace=mobile",
    "lint": "npm run typecheck",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspace=backend"
  }
}
